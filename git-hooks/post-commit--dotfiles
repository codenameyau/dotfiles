#!/bin/bash
#
# Installation (from the root of this dotfiles repo; setup.sh does this for you):
# cp git-hooks/post-commit--dotfiles .git/hooks/post-commit && chmod ug+x .git/hooks/post-commit
#
# Description:
# Hook to update the dotfiles in $HOME when changes to them are committed to this repo.
# Only files that already exist in $HOME are updated, matching update.sh.

# Files changed by the commit that was just made. --root handles the first commit.
committed_files="$(git diff-tree -r --root --name-only --no-commit-id HEAD)"

# Copy shell/<file> to ~/<file> if the commit changed it and ~/<file> already exists.
update_if_committed() {
  local file="$1"

  if grep --quiet --line-regexp --fixed-strings "shell/$file" <<< "$committed_files" && [ -f ~/"$file" ]; then
    cp "shell/$file" ~/"$file"
    echo "[+] Updated ~/$file"
  fi
}

echo "Running post-commit hook on dotfiles"

update_if_committed .bash_aliases
update_if_committed .bash_extras
update_if_committed .bashrc
update_if_committed .bash_profile
update_if_committed .zshrc
update_if_committed .zshrc_extras
update_if_committed .gitconfig
update_if_committed .gitignore_global

# Sourcing here would only affect this hook's own process, not your open shells.
echo "Open a new terminal or re-source your shell config to pick up changes."
echo # new line
