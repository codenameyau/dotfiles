#################################################
# Kubernetes: zsh-kubectl-prompt 
# https://github.com/superbrothers/zsh-kubectl-prompt
#################################################

# https://github.com/zsh-users/zsh/blob/master/Functions/Misc/colors
autoload -U colors; colors

# Homebrew lives in /opt/homebrew (Apple Silicon) or /usr/local (Intel).
# HOMEBREW_PREFIX is set by `brew shellenv`; avoid calling `brew --prefix` (slow).
brew_prefix="${HOMEBREW_PREFIX:-$([ -d /opt/homebrew ] && echo /opt/homebrew || echo /usr/local)}"

if [ -f "$brew_prefix/etc/zsh-kubectl-prompt/kubectl.zsh" ]; then
  source "$brew_prefix/etc/zsh-kubectl-prompt/kubectl.zsh"

  function right_prompt() {
    local color="magenta"

    if [[ "$ZSH_KUBECTL_USER" =~ "admin" ]]; then
      color="white"
    fi

    echo "%{$fg_bold[$color]%}($ZSH_KUBECTL_PROMPT)%{$reset_color%}"
  }

  RPROMPT='$(right_prompt)'
fi

# Git extras
if [ -f "$brew_prefix/opt/git-extras/share/git-extras/git-extras-completion.zsh" ]; then
  source "$brew_prefix/opt/git-extras/share/git-extras/git-extras-completion.zsh"
fi

unset brew_prefix
